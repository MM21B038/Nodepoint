# OpenRouter / LLM API (required for Agent and KG extraction)
BASE_URL=https://openrouter.ai/api/v1
API_KEY=
# HTTP timeout in seconds for Agent API calls (connect uses 10s). Default 120.
# AGENT_REQUEST_TIMEOUT=120
# Skip GET /models validation (use if worker cannot reach provider catalog)
# AGENT_SKIP_MODEL_VALIDATION=false

# Django
SECRET_KEY=change-me-in-production
DEBUG=True

# Chat WebSocket
# CHAT_COMPRESS_TOKEN_THRESHOLD=64000
# Max concurrent Knowledge.search_graph runs per web worker (default 8)
# CHAT_MAX_CONCURRENT_SEARCHES=8
# Uvicorn worker processes for ASGI (default 4)
# WEB_WORKERS=4
# DB_CONN_MAX_AGE=60
# Override fixed chat system prompt (default: Prompt["chat_system"] in code)
# CHAT_DEFAULT_SYSTEM=
# ALLOWED_HOSTS=localhost,127.0.0.1

# Optional: override settings.toml [agent] parser model (KG structured extraction)
# AGENT_PARSER=

# Optional overrides for settings.toml
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_NAME=nodepoint
# POSTGRES_USER=nodepoint
# POSTGRES_PASSWORD=nodepoint
# MONGO_HOST=localhost
# REDIS_HOST=localhost
# QDRANT_HOST=localhost
